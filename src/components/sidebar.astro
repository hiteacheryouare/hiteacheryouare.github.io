---
import { navLinks } from '../utils/navigation';
import lockupLight from '../img/new/rm-lockup-black.svg';
import lockupDark from '../img/new/rm-lockup-white.svg';

const { currentPath } = Astro.props;

const isCurrent = (href: string) => {
	if (href.includes('#')) return false;
	return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
};
---

<div class="sidebar">
	<a class="sidebar-id no-rainbow" href="/" aria-label="Ryan Mullin, home">
		<img class="logo-light" src={lockupLight.src} alt="Ryan Mullin" />
		<img class="logo-dark" src={lockupDark.src} alt="Ryan Mullin" />
	</a>

	<nav class="sidebar-nav" aria-label="Primary">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					class:list={['no-rainbow', { 'is-here': isCurrent(link.href) }]}
					style={`--mark: var(--grad-${link.mark})`}
					aria-current={isCurrent(link.href) ? 'page' : undefined}
				>
					<span>{link.name}</span>
				</a>
			))
		}
	</nav>

	<button
		type="button"
		class="sidebar-toggle no-rainbow"
		data-shell-toggle
		aria-expanded="true"
		aria-label="Collapse navigation"
	>
		<i class="bi bi-chevron-double-left" aria-hidden="true"></i>
	</button>
</div>

<div class="shell-edge" aria-hidden="true"></div>
