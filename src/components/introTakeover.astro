---
import lockup from '../img/new/rm-lockup-fullwhite.svg';
---

<div class="takeover" data-takeover hidden></div>
<div class="takeover-mark" data-takeover-mark hidden>
	<img src={lockup.src} alt="" />
</div>

<script>
	const HOLD = 900;
	const RETRACT = 1000;

	const playIntro = () => {
		const bands = document.querySelector<HTMLElement>('[data-takeover]');
		const mark = document.querySelector<HTMLElement>('[data-takeover-mark]');
		if (!bands || !mark) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			bands.remove();
			mark.remove();
			return;
		}

		bands.hidden = false;
		mark.hidden = false;
		document.body.classList.add('is-taken-over');

		setTimeout(() => {
			bands.classList.add('is-retracting');
			mark.classList.add('is-retracting');
			document.body.classList.remove('is-taken-over');
		}, HOLD);

		setTimeout(() => {
			bands.remove();
			mark.remove();
		}, HOLD + RETRACT);
	};

	playIntro();
</script>
