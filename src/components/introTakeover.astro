---
import Monogram from './monogram.astro';
---

<div class="takeover" data-takeover transition:persist="takeover" hidden></div>
<div class="takeover-mark" data-takeover-mark transition:persist="takeover-mark" hidden>
	<Monogram />
</div>

<script>
	// Draw, fill, then hold filled for a beat before the monogram and the
	// backdrop leave together.
	const SETTLED = 2400;
	const RETRACT = 850;

	const playIntro = () => {
		const bands = document.querySelector<HTMLElement>('[data-takeover]');
		const mark = document.querySelector<HTMLElement>('[data-takeover-mark]');
		const flying = mark?.querySelector<SVGElement>('svg');
		const seat = document.querySelector<SVGElement>('.sidebar-id svg');
		if (!bands || !mark || !flying || !seat) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		bands.hidden = false;
		mark.hidden = false;
		document.body.classList.add('is-taken-over');

		setTimeout(() => {
			// Measure the seat the monogram is flying to, then send it there.
			const from = flying.getBoundingClientRect();
			const to = seat.getBoundingClientRect();
			flying.style.transform = [
				`translate(${to.left + to.width / 2 - (from.left + from.width / 2)}px,`,
				`${to.top + to.height / 2 - (from.top + from.height / 2)}px)`,
				`scale(${to.height / from.height})`,
			].join(' ');

			bands.classList.add('is-retracting');
			mark.classList.add('is-retracting');
			document.body.classList.remove('is-taken-over');
		}, SETTLED);

		setTimeout(() => {
			bands.hidden = true;
			mark.hidden = true;
		}, SETTLED + RETRACT);
	};

	playIntro();
</script>
