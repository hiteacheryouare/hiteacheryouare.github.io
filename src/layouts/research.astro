---
const { title, author, publishDate, wordCount, type } = Astro.props.content;

const typeLabels: Record<string, string> = {
	IRR: 'Research Report',
	IWA: 'Written Argument',
	Research: 'Research Article',
};
const typeLabel = typeLabels[type] ?? type;

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<article class="research">
	<p class="release-back"><a href="/research">← All research</a></p>

	<header class="release-head">
		<h1 transition:name={title}>{title}</h1>
		<p class="release-by">
			{typeLabel} · {author || 'Ryan Mullin'} ·
			<time datetime={publishDate} transition:name={publishDate}>{formattedDate}</time> ·
			{wordCount.toLocaleString()} words
		</p>
	</header>

	<div class="copy">
		<slot />
	</div>

	<aside class="boilerplate">
		<h2>Cite this work</h2>
		<p>
			{author || 'Ryan Mullin'}. ({publishDate ? new Date(publishDate).getFullYear() : 'n.d.'}).
			<em>{title}</em>. Retrieved from {Astro.request.url}
		</p>
	</aside>
</article>
