---
import Layout from './Layout.astro';

const { name, description, date, freelance, url, heroImage } = Astro.props.content;

// Matches the names the work index gives this project, so the card morphs into
// the page. Derived from the entry id because it is unique; an alt string is not.
const morph = `work-${Astro.props.id ?? name}`;
---

<Layout
	title={`${name} | Portfolio`}
	description={description}
	image={heroImage?.src || '/waves.png'}
	imageAlt={heroImage?.alt || name}
>
	<article class="project">
		<p class="release-back"><a href="/work">← All work</a></p>

		<header class="release-head">
			<h1 transition:name={`${morph}-title`}>{name}</h1>
			<p class="release-lede" transition:name={`${morph}-lede`}>{description}</p>
		</header>

		<dl class="facts">
			<div><dt>Year</dt><dd>{date}</dd></div>
			<div><dt>For</dt><dd>{freelance ? 'A client' : 'Myself'}</dd></div>
			<div><dt>Live at</dt><dd><a href={url}>{url.replace(/^https?:\/\//, '')}</a></dd></div>
		</dl>

		{
			heroImage?.src && (
				<div class="plate release-plate">
					<img
						src={heroImage.src}
						alt={heroImage.alt || name}
						decoding="async"
						transition:name={`${morph}-image`}
					/>
				</div>
			)
		}

		<div class="copy">
			<slot />
		</div>

		<p class="release-share"><a href={url}>Visit the live site</a></p>
	</article>
</Layout>
