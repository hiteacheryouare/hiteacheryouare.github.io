---
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/sidebar.astro';
import SiteFooter from '../components/siteFooter.astro';
import '../globals.scss';
import '../styles/bootstrap.scss';
import '../styles/shell.scss';
import '../../node_modules/bootstrap-icons/font/bootstrap-icons.scss';

const { title, description, image = '/waves.png', imageAlt = 'colorful, wavy rainbow waves' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/2025/RM-monogram-black-on-transparent.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<script>
			function setBsDarkMode() {
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.body.setAttribute('data-bs-theme', 'dark');
				} else {
					document.body.setAttribute('data-bs-theme', 'light');
				}
			}
			setBsDarkMode();
			document.addEventListener('astro:after-swap', setBsDarkMode);
		</script>
		<SEO
			title={`${title} | Ryan Mullin`}
			description={description}
			noindex={false}
			nofollow={false}
			openGraph={{
				basic: {
					title: `${title}`,
					type: 'website',
					image: image,
					url: Astro.request.url,
				},
				optional: {
					description: description,
					locale: 'en-US',
					siteName: "Ryan Mullin's Personal Website",
				},
				image: {
					alt: imageAlt,
				},
			}}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=DM+Serif+Text:ital@0;1&display=swap"
			rel="stylesheet"
		/>
		<script type="module" src="/themeFavicon.js"></script>
	</head>
	<body>
		<div class="shell" data-shell>
			<Sidebar currentPath={currentPath} />
			<main class="main-column">
				<slot />
				<SiteFooter />
			</main>
		</div>

		<script>
			const COLLAPSE_AFTER = 80;

			const setupShell = () => {
				const shell = document.querySelector<HTMLElement>('[data-shell]');
				const toggle = document.querySelector<HTMLButtonElement>('[data-shell-toggle]');
				if (!shell) return;

				let lastScrollY = window.scrollY;
				let pinnedOpen = false;

				const setCollapsed = (collapsed: boolean) => {
					shell.classList.toggle('is-collapsed', collapsed);
					if (!toggle) return;
					toggle.setAttribute('aria-expanded', String(!collapsed));
					toggle.setAttribute(
						'aria-label',
						collapsed ? 'Expand navigation' : 'Collapse navigation'
					);
					toggle.firstElementChild?.classList.toggle('bi-chevron-double-left', !collapsed);
					toggle.firstElementChild?.classList.toggle('bi-chevron-double-right', collapsed);
				};

				const onScroll = () => {
					const y = window.scrollY;
					if (y <= COLLAPSE_AFTER) {
						pinnedOpen = false;
						setCollapsed(false);
					} else if (!pinnedOpen && y > lastScrollY) {
						setCollapsed(true);
					} else if (!pinnedOpen && y < lastScrollY) {
						setCollapsed(false);
					}
					lastScrollY = y;
				};

				// A deliberate click outranks scrolling until the reader returns to the top.
				toggle?.addEventListener('click', () => {
					pinnedOpen = true;
					setCollapsed(!shell.classList.contains('is-collapsed'));
				});

				window.addEventListener('scroll', onScroll, { passive: true });
				document.addEventListener(
					'astro:before-swap',
					() => window.removeEventListener('scroll', onScroll),
					{ once: true }
				);
			};

			// ClientRouter fires this on the first load too, so it is the only hook needed.
			document.addEventListener('astro:page-load', setupShell);
		</script>
	</body>
</html>
