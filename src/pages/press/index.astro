---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const releases = await getCollection('press');
releases.sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout
	title="Newsroom"
	description="Everything Ryan Mullin has written, and everything written about him."
>
	<div class="centered">
		<div class="page-open">
			<h1>Newsroom</h1>
		</div>

		{
			releases.length === 0 ? (
				<p>No posts yet. Check back soon!</p>
			) : (
				<ul class="release-index">
					{releases.map((release) => (
						<li>
							<a class="plate no-rainbow" href={`/press/${release.id}`}>
								<img
									src={release.data.heroImage?.src ?? '/waves.png'}
									alt={release.data.heroImage?.alt ?? release.data.title}
									transition:name={release.data.heroImage?.alt ?? release.id}
								/>
							</a>
							<div>
								<time datetime={release.data.pubDate}>
									{new Date(release.data.pubDate).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
								<h3>
									<a href={`/press/${release.id}`} transition:name={release.data.title}>
										{release.data.title}
									</a>
								</h3>
								<p transition:name={release.data.description}>{release.data.description}</p>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Layout>
