---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatArticleDate, articleDateAttr, articleDateValue } from '../../utils/articleDate';

const releases = await getCollection('press');
releases.sort((a, b) => articleDateValue(b.data.pubDate) - articleDateValue(a.data.pubDate));
---

<Layout
	title="Newsroom"
	description="Everything Ryan Mullin has written, and everything written about him."
>
	<div class="centered">
		<div class="page-open">
			<h1>Newsroom</h1>
		</div>

		{
			releases.length === 0 ? (
				<p>No posts yet. Check back soon!</p>
			) : (
				<ul class="release-index">
					{releases.map((release) => (
						<li>
							<a
								class:list={[
									'plate',
									'no-rainbow',
									release.data.heroImage?.portrait && 'plate-portrait',
								]}
								href={`/press/${release.id}`}
							>
								<img
									src={release.data.heroImage?.src ?? '/waves.png'}
									alt={release.data.heroImage?.alt ?? release.data.title}
									width={release.data.heroImage?.width}
									height={release.data.heroImage?.height}
									loading="lazy"
									decoding="async"
									transition:name={`press-${release.id}-image`}
								/>
							</a>
							<div>
								<time
									datetime={articleDateAttr(release.data.pubDate)}
									transition:name={`press-${release.id}-date`}
								>
									{formatArticleDate(release.data.pubDate)}
								</time>
								<h3>
									<a
										href={`/press/${release.id}`}
										transition:name={`press-${release.id}-title`}
									>
										{release.data.title}
									</a>
								</h3>
								<p transition:name={`press-${release.id}-lede`}>{release.data.description}</p>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Layout>
