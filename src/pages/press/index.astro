---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const releases = await getCollection('press');
releases.sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout title="Press" description="Everything Ryan Mullin has written, and everything written about him.">
	<div class="page__open">
		<h1>Thoughts &amp; Ideas</h1>
		<p>All posts organized by date.</p>
	</div>

	<div class="page__h2">
		<h2>Releases</h2>
		<p>{releases.length} of them</p>
	</div>

	{
		releases.length === 0 ? (
			<p class="stackline">No posts yet. Check back soon!</p>
		) : (
			<ul class="release-list">
				{releases.map((release) => (
					<li>
						<div>
							<h3>
								<a href={`/press/${release.id}`} transition:name={release.data.title}>
									{release.data.title}
								</a>
							</h3>
							<p transition:name={release.data.description}>{release.data.description}</p>
						</div>
						<time datetime={release.data.pubDate}>
							{new Date(release.data.pubDate).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
						</time>
					</li>
				))}
			</ul>
		)
	}
</Layout>
