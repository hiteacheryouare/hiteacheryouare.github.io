---
import Layout from '../layouts/Layout.astro';

const mistakes = [
	'Blunder', 'Mistake', 'Error', 'Fault', 'Inaccuracy', 'Omission', 'Slip', 'Slip-up', 'Miscalculation', 'Misunderstanding', 'Flaw', 'Oversight', 'Fallacy', 'Goof', 'Lapse', 'Misstep', 'Botch', 'Snafu', 'Faux pas', 'Howler', 'Catastrophe', 'Debacle', 'Fiasco', 'Misadventure', 'Calamity', 'Disaster', 'Tragedy', 'Screw-up', 'Blooper', 'Utter disaster', 'Train wreck', 'Dumpster fire', 'Gaffe', 'Bungle', 'Flub', 'Fumble', 'Mess-up', 'Cockup', 'Ballup', 'Foul-up', 'Mixup', 'Glitch', 'Hiccup', 'Misfire', 'Stumble', 'Trip-up', 'Wrong move', 'Misjudgment', 'Lapse in judgment', 'Miscue', 'Misdoing', 'Transgression', 'Boo-boo', 'Oopsie', 'Total failure', 'Mess', 'Shambles', 'Wreck', 'Breakdown', 'Flop', 'Washout'
];

const icons = [
	'cone', 'cone-striped', 'dash-circle', 'dash-circle-dotted', 'dash-circle-fill', 'dash-square', 'dash-square-dotted', 'exclamation-triangle', 'exclamation-triangle-fill', 'exclamation', 'exclamation-circle', 'exclamation-diamond', 'exclamation-diamond-fill', 'exclamation-lg', 'exclamation-octagon', 'exclamation-octagon-fill', 'exclamation-square', 'exclamation-square-fill', 'hand-thumbs-down', 'emoji-frown', 'explicit', 'explicit-fill', 'heartbreak', 'slash-circle', 'slash-circle-fill', 'heartbreak-fill', 'piggy-bank-fill', 'piggy-bank', 'cloud-lightning-rain', 'browser-edge', 'bug-fill', 'bug', 'browser-chrome', 'browser-firefox', 'browser-safari'
];

const broVariations = [
	'bro', 'brochacho', 'brochacho', 'brochacho', 'brochacho', 'brochacho', 'brochacho', 'brochacho', 'broseph', 'bruh', 'bud', 'blud', 'buddy', 'bucko', 'mate', 'amigo', 'compadre', 'brosephina', 'brotien shake', 'brofessor', 'broletariat', 'brotagonist', 'brohemian rhapsody', 'brotanical Garden', 'brotato Chip', 'brosidon', 'brometheus', 'C3P-Bro', 'broseph stalin', 'brojangles', 'theodore broosevelt', 'bronana'
];

const exclamationIntensities = [
	'!!', '!!!', '!!!!', '!!!!!', '!!!!!!!!', '!!!!!!!!!!', '!!!!!!!!!!!', '!!!!!!!!!!!!', '!!!!!!!!!!!!!', '!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!!!!!', '!!!!!!!!!!!!!!!!!!!!!!'
];

const combinations =
	mistakes.length * icons.length * broVariations.length * exclamationIntensities.length;
---

<Layout title="404 not found!!!" description="nope, we cant find da page">
	<div class="notfound">
		<i id="random-icon" class="notfound-icon" aria-hidden="true"></i>

		<h1 id="random-mistake"></h1>
		<p id="random-bro" class="notfound-bro"></p>
		<p>Try something else?? 🤷‍♂️</p>

		<p class="notfound-actions">
			<a href="/">Go home</a> · <button type="button" data-go-back>Go back</button> ·
			<button type="button" data-reroll>Reroll</button>
		</p>

		<p class="notfound-tally">
			Error 404 · reroll <span id="reroll-count">1</span> of a possible {combinations.toLocaleString()}
		</p>
	</div>
</Layout>

<style>
	.notfound {
		max-width: 44ch;
		margin-inline: auto;
		text-align: center;
		padding-block: clamp(1rem, 6vh, 4rem);
	}

	.notfound-icon {
		font-size: 5rem;
		color: var(--grad-red);
		display: inline-block;
		animation: bounce404 2s infinite;
	}

	.notfound h1 {
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.05;
		color: var(--grad-red);
		margin: 1rem 0 0.5rem;
		overflow-wrap: anywhere;
	}

	.notfound-bro {
		font-style: italic;
		color: var(--ink-2);
	}

	.notfound p {
		color: var(--ink-2);
	}

	.notfound-actions {
		margin: 1.75rem 0 0;
		color: var(--ink-3);
	}

	.notfound-actions button {
		border: 0;
		background: none;
		padding: 0;
		color: var(--grad-blue);
		cursor: pointer;
	}

	.notfound-actions button:hover {
		text-decoration: underline;
	}

	.notfound-tally {
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule-soft);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8125rem;
		color: var(--ink-3);
	}

	@keyframes bounce404 {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-20px); }
	}
</style>

<script define:vars={{ mistakes, icons, broVariations, exclamationIntensities }}>
	const pick = (list) => list[Math.floor(Math.random() * list.length)];

	const icon = document.getElementById('random-icon');
	const shout = document.getElementById('random-mistake');
	const bro = document.getElementById('random-bro');
	const tally = document.getElementById('reroll-count');

	let rerolls = 0;
	let shown = '';

	const roll = () => {
		if (shown) icon.classList.remove(shown);
		shown = `bi-${pick(icons)}`;
		icon.classList.add('bi', shown);
		shout.textContent = pick(mistakes) + pick(exclamationIntensities);
		bro.textContent = `(that means ur in the wrong spot ${pick(broVariations)})`;
		rerolls += 1;
		tally.textContent = rerolls.toString();
	};

	roll();

	document.querySelector('[data-go-back]').addEventListener('click', () => window.history.back());
	document.querySelector('[data-reroll]').addEventListener('click', roll);
</script>
