---
import Layout from '../../layouts/Layout.astro';

const researchPapers = [
	{
		title: 'Opting Out or Weighing In: Decision Directed SAT Score Submission',
		href: '/research/ooowi',
		description:
			'An analysis of test-optional policies and their impact on college admissions decisions',
		date: '2024',
		type: 'Research Article',
	},
	{
		title: 'The Ineffectiveness of Climate Change Policies in the United States',
		href: '/research/climate-change',
		description:
			'Examining the structural and political barriers to effective climate policy implementation',
		date: '2024',
		type: 'Written Argument',
	},
	{
		title: 'Enhancing Vaccine Communication to Address Intelligent Disobedience',
		href: '/research/vaccines',
		description:
			'Strategies for improving public health messaging and addressing vaccine hesitancy',
		date: '2024',
		type: 'Research Report',
	},
];
---

<Layout
	title="Research"
	description="Exploring ideas through rigorous analysis and evidence-based inquiry"
>
	<div class="centered">
	<div class="page-open">
		<h1>Academic &amp; Research</h1>
		<p>Exploring ideas through rigorous analysis and evidence-based inquiry.</p>
	</div>

	<div class="section-head">
		<h2>Papers</h2>
	</div>

	<ul class="release-list">
		{
			researchPapers.map((paper) => (
				<li>
					<div>
						<h3>
							<a href={paper.href}>{paper.title}</a>
						</h3>
						<p>{paper.description}</p>
					</div>
					<time>{paper.type}, {paper.date}</time>
				</li>
			))
		}
	</ul>
	</div>
</Layout>
