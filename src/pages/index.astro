---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
projects.sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const featuredProjects = projects.slice(0, 4);

const releases = await getCollection('press');
releases.sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const recentReleases = releases.slice(0, 3);
---

<Layout title="Home" description="Ryan Mullin builds websites and browser extensions.">
	<section class="hero">
		<div>
			<h1>I like to build cool things using cool tools.</h1>
			<p>And sometimes I make things that make me laugh. I hope you do too.</p>
		</div>
		<figure class="hero-figure">
			<img src="https://avatars.githubusercontent.com/u/82683251" alt="Ryan Mullin" />
		</figure>
	</section>

	<section class="page-section">
		<div class="section-head">
			<h2>Some of my faves</h2>
			<a href="/work">All work</a>
		</div>

		<div class="work-grid">
			{
				featuredProjects.map((project) => (
					<article>
						<a class="plate no-rainbow" href={`/portfolio/projects/${project.id}`}>
							<img
								src={project.data.heroImage?.src || '/waves.png'}
								alt={project.data.heroImage?.alt || project.data.name}
							/>
						</a>
						<h3>
							<a href={`/portfolio/projects/${project.id}`}>{project.data.name}</a>
							<time>{new Date(project.data.date).getFullYear()}</time>
						</h3>
						<p>{project.data.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="page-section">
		<div class="section-head">
			<h2>Newsroom</h2>
			<a href="/press">All of it</a>
		</div>
		<ul class="release-index">
			{
				recentReleases.map((release) => (
					<li>
						<a class="plate no-rainbow" href={`/press/${release.id}`}>
							<img
								src={release.data.heroImage?.src ?? '/waves.png'}
								alt={release.data.heroImage?.alt ?? release.data.title}
							/>
						</a>
						<div>
							<time datetime={release.data.pubDate}>
								{new Date(release.data.pubDate).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
							<h3>
								<a href={`/press/${release.id}`}>{release.data.title}</a>
							</h3>
							<p>{release.data.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section id="contact" class="page-section">
		<div class="section-head">
			<h2>Want to chat?</h2>
			<p>Looking for a co-op? Have freelance work? We both know you have something to say!</p>
		</div>
		<form class="contact-form" data-contact-form>
			<div class="contact-row">
				<div>
					<label class="form-label" for="contactName">Name</label>
					<input class="form-control" id="contactName" name="name" type="text" placeholder="Your name" />
				</div>
				<div>
					<label class="form-label" for="contactEmail">Email</label>
					<input class="form-control" id="contactEmail" name="email" type="email" placeholder="your@email.com" required />
				</div>
			</div>
			<div>
				<label class="form-label" for="contactMessage">Message</label>
				<textarea class="form-control" id="contactMessage" name="message" rows="3" placeholder="Tell me about your project or opportunity..."></textarea>
			</div>
			<button class="btn btn-primary" type="submit">Send Message</button>
		</form>
	</section>
</Layout>

<script>
	// Browsers don't reliably submit a form to a mailto: action, so compose the
	// message into the user's mail client instead.
	document.addEventListener('astro:page-load', () => {
		const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const { name, email, message } = Object.fromEntries(
				new FormData(form).entries()
			) as Record<string, string>;
			const subject = encodeURIComponent(`Contact from ${name || 'the website'}`);
			const body = encodeURIComponent(`${message}\n\nFrom: ${name}\nEmail: ${email}`);
			window.location.href = `mailto:rpmullin17@gmail.com?subject=${subject}&body=${body}`;
		});
	});
</script>
