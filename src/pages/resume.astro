---
import Layout from '../layouts/Layout.astro';
import Resume from '../components/resume.astro';
---

<Layout title="Résumé" description="Ryan Mullin's résumé, on the web and as a PDF.">
	<div class="section-head resume-bar">
		<h2>Résumé</h2>
		<a href="/ryan-mullin-resume.pdf" download="Ryan Mullin Resume.pdf">Download the PDF</a>
	</div>

	<Resume />
</Layout>

<style>
	@media print {
		.resume-bar {
			display: none;
		}
	}
</style>
